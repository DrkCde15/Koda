# Exemplo de variáveis de ambiente
# Copie para .env e ajuste antes de subir em produção.

# Backend
FLASK_ENV=development
DATABASE_URL=postgresql://koda:koda@localhost:5432/koda
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-use-a-long-random-string
JWT_SECRET_KEY=change-me-use-a-long-random-jwt-secret
CORS_ORIGINS=*
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760

# Frontend (usa o proxy do Vite em dev; em produção usa /api via nginx)
VITE_API_URL=/api
