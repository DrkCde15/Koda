# =============================================================================
# KODA - Configuração de Ambiente
# =============================================================================
# Copie este arquivo para .env e ajuste os valores antes de subir em produção
# NUNCA commite o arquivo .env para o repositório!
# =============================================================================

# --- Ambiente ---
FLASK_ENV=development
# Opções: development, testing, production

# --- Banco de Dados ---
# PostgreSQL (Produção/Docker):
DATABASE_URL=postgresql://koda:koda@localhost:5432/koda
# SQLite (Desenvolvimento local - descomente abaixo e comente o PostgreSQL):
# DATABASE_URL=

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- SEGURANÇA (OBRIGATÓRIO EM PRODUÇÃO!) ---
# Gere chaves fortes com: openssl rand -hex 32
SECRET_KEY=gere-uma-chave-secreta-forte-aqui-minimo-32-caracteres
JWT_SECRET_KEY=gere-uma-chave-jwt-forte-aqui-minimo-32-caracteres
# Opcional: chave separada para tokens de reset de senha (padrão: usa JWT_SECRET_KEY)
RESET_TOKEN_SECRET=

# --- JWT ---
JWT_ACCESS_EXP_MIN=15
JWT_REFRESH_EXP_DAYS=30

# --- CORS ---
CORS_ORIGINS=http://localhost:5000,http://localhost:5173

# --- Upload ---
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
# 16MB em bytes (padrão). Ajuste conforme necessário.

# --- Email (Opcional - para reset de senha) ---
# Opção 1: Google Apps Script (configurado no config/__init__.py)
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=
# Opção 2: SMTP direto
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
SMTP_FROM=Koda <noreply@koda.com>

# --- Rate Limiting ---
RATELIMIT_STORAGE_URL=redis://localhost:6379/1
RATELIMIT_DEFAULT=100 per hour
# Configurações específicas:
RATELIMIT_LOGIN=5 per minute
RATELIMIT_REGISTER=3 per hour
RATELIMIT_PASSWORD_RESET=3 per hour

# --- Logs ---
LOG_LEVEL=INFO
LOG_FORMAT=json
# Opções: json, text

# --- Frontend ---
VITE_API_URL=/api
# Em produção, o backend serve o frontend, então use /api
