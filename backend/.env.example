# Banco de dados
DATABASE_URL=postgresql://koda:koda@localhost:5432/koda

# Redis (opcional — modo degradado se ausente)
REDIS_URL=redis://localhost:6379/0

# Segurança (SOBRESCREVA em produção)
SECRET_KEY=dev-secret-change-me-please-override-in-prod-32
JWT_SECRET_KEY=jwt-dev-secret-change-me-please-override-prod-32

# Frontend (usado nos links de email de reset/convite)
FRONTEND_URL=http://localhost

# Email transacional via Google Apps Script (GmailApp)
# Deixe vazio para rodar em modo degradado (sem envio de email)
EMAIL_PROVIDER=google_script
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=
EMAIL_REMETENTE=no-reply@koda.app
EMAIL_FROM_NAME=Koda

# Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760
